# DE10-Lite ZX Spectrum -- Quartus project settings
#
# Pin assignments cross-checked against three independent DE10-Lite projects
# (hildebrandmw/de10lite-hdl, MIPSfpga/schoolMIPS, yuri-panchul/
# basics-graphics-music), all ultimately derived from Terasic's System CD.
# 121 pins, zero disagreements between sources.

set_global_assignment -name FAMILY "MAX 10"
set_global_assignment -name DEVICE 10M50DAF484C7G
set_global_assignment -name TOP_LEVEL_ENTITY de10_lite_speccy48
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL

# The full machine needs rom48.hex in this directory (tools/bin2hex.py).
# For the CPU-less static-screen ladder step, switch the top instead:
#   set_global_assignment -name TOP_LEVEL_ENTITY de10_lite_top
# and provide screen.hex (make run emits one via --mem).

# Unused pins high-Z, and the whole bank is 3.3V.
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED"

# MAX 10 internal configuration MUST include memory initialization ("ERAM"),
# or no $readmemh RAM can be inferred at all -- every initialised memory
# fails with 276013 "MIF is not supported for the selected family" and
# synthesis dies at 276003. This setting is why; never remove it.
set_global_assignment -name INTERNAL_FLASH_UPDATE_MODE "SINGLE IMAGE WITH ERAM"
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

# ---- RTL ------------------------------------------------------------------
set_global_assignment -name VERILOG_FILE ../rtl/video_timing.v
set_global_assignment -name VERILOG_FILE ../rtl/vram.v
set_global_assignment -name VERILOG_FILE ../rtl/ram.v
set_global_assignment -name VERILOG_FILE ../rtl/video.v
set_global_assignment -name VERILOG_FILE ../rtl/palette.v
set_global_assignment -name VERILOG_FILE ../rtl/scandoubler.v
set_global_assignment -name VERILOG_FILE ../rtl/keyboard.v
set_global_assignment -name VERILOG_FILE ../rtl/ps2_rx.v
set_global_assignment -name VERILOG_FILE ../rtl/ps2_keyboard.v
set_global_assignment -name VERILOG_FILE ../rtl/joystick.v
set_global_assignment -name VERILOG_FILE ../rtl/key_tap.v
set_global_assignment -name VERILOG_FILE ../rtl/spi_master.v
set_global_assignment -name VERILOG_FILE ../rtl/ay8912.v
set_global_assignment -name VERILOG_FILE ../rtl/sdram.v
set_global_assignment -name VERILOG_FILE ../rtl/speccy.v
set_global_assignment -name VERILOG_FILE ../rtl/speccy48.v
set_global_assignment -name VERILOG_FILE ../rtl/speccy_video_top.v
set_global_assignment -name VERILOG_FILE ../rtl/de10_lite_top.v
set_global_assignment -name VERILOG_FILE ../rtl/de10_lite_speccy48.v
set_global_assignment -name VERILOG_FILE ../rtl/pll.v
set_global_assignment -name VERILOG_FILE ../rtl/tv80/tv80s.v
set_global_assignment -name VERILOG_FILE ../rtl/tv80/tv80_core.v
set_global_assignment -name VERILOG_FILE ../rtl/tv80/tv80_alu.v
set_global_assignment -name VERILOG_FILE ../rtl/tv80/tv80_mcode.v
set_global_assignment -name VERILOG_FILE ../rtl/tv80/tv80_reg.v
set_global_assignment -name SDC_FILE speccy.sdc

